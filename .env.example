# --- Base de données -------------------------------------------------------
# SQLite : un seul fichier, sauvegardable par simple copie.
DATABASE_URL="file:./dev.db"

# --- Secrets ---------------------------------------------------------------
# Générez chaque valeur avec :  openssl rand -base64 32
# APP_SESSION_SECRET  : signature du cookie de session.
# APP_ENCRYPTION_KEY  : chiffrement des identifiants du coffre.
#   ⚠️ Perdre APP_ENCRYPTION_KEY rend les secrets stockés définitivement illisibles.
APP_SESSION_SECRET="remplacez-moi-par-une-valeur-aleatoire-de-32-caracteres"
APP_ENCRYPTION_KEY="remplacez-moi-par-une-autre-valeur-aleatoire"
